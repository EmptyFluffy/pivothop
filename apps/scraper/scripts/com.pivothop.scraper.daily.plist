<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pivothop.scraper.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/carlos/PivotHop/apps/scraper/scripts/daily-run.sh</string>
  </array>

  <!-- Twice daily, 07:15 and 16:15 local. If the Mac was asleep, launchd runs
       a missed slot once at next wake. The run script's marker file already
       makes overlapping runs impossible, and the first-seen ledger keeps ages
       honest across partial pulls, so a second run is pure increment. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/carlos/PivotHop/apps/scraper/data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/carlos/PivotHop/apps/scraper/data/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
