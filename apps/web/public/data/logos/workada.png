<svg
   width="100%"
   viewBox="0 0 680 680"
   role="img"
   xmlns="http://www.w3.org/2000/svg">
  <title>Workada icon</title>
  <g transform="matrix(3,0,0,3,122.5,175)">
    <!-- Back W (lighter) -->
    <path
       d="M 25,0 55,110 85,50 115,110 145,0"
       fill="none"
       stroke="#4a7c9b"
       stroke-width="18"
       stroke-linecap="round"
       stroke-linejoin="round"
       opacity="0.85" />
    <!-- Front W (darker - matches site primary) -->
    <path
       d="M 0,0 30,110 60,50 90,110 120,0"
       fill="none"
       stroke="#1e3a5f"
       stroke-width="18"
       stroke-linecap="round"
       stroke-linejoin="round" />
  </g>
</svg>
