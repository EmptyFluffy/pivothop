# PivotHop · copy to .env at the repo root. Everything is optional: the scraper runs
# local-first (NDJSON under apps/scraper/data/) with the keyless sources alone.

# Adzuna (free at developer.adzuna.com) · primary breadth + salary source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS (free at developer.usajobs.gov) · US public sector, clean salary bands
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Supabase · the scraper mirror AND the /employers job-submission capture.
# Schema in supabase/migrations/ (run 0001 + 0002). On Vercel set these in the
# project's Environment Variables; locally the web falls back to a mailto.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Postmark (optional) · emails you when an employer submits a job. Without it
# the submission still lands in Supabase; you just check the table.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
POSTMARK_NOTIFY_TO=

# Admin console (/admin) · HTTP Basic Auth for reviewing job submissions.
ADMIN_PASSWORD=
ADMIN_USER=

# Lemon Squeezy (automated employer payments, Merchant of Record). Create a
# store + two product variants (Standard, Featured), an API key, and a webhook
# (event order_created) at https://www.pivothop.com/api/lemonsqueezy/webhook.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STD=
LEMONSQUEEZY_VARIANT_FEAT=
LEMONSQUEEZY_WEBHOOK_SECRET=

# PostHog · product analytics. The web app reads these two public vars (they're
# NEXT_PUBLIC_ so they're embedded at build time). On Vercel set them in the
# project's Environment Variables for the Production environment. Without them
# the client no-ops and the server-side capture throws (caught, so the webhook
# still returns 200, but the event is lost).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Social autoposter (docs/35) ────────────────────────────────────────────────
# Vercel Cron calls /api/social/cron with this bearer; unset = feature off.
CRON_SECRET=
# Gates /api/social/feed and /api/social/consume (the Zapier queue). Long random string.
SOCIAL_FEED_TOKEN=
# false (default): cron queues drafts for approval in /admin/social. true: straight to the feed.
SOCIAL_AUTO_APPROVE=false
SOCIAL_POSTS_PER_DAY=3
SOCIAL_HASHTAGS=#hiring #careers
SOCIAL_DEDUP_DAYS=45
# Future direct LinkedIn publishing (lib/social/linkedin.ts, not wired; Zapier publishes today):
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202608
