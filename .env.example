# PivotHop — copy to .env at the repo root. Everything is optional: the scraper runs
# local-first (NDJSON under apps/scraper/data/) with the keyless sources alone.

# Adzuna (free at developer.adzuna.com) — primary breadth + salary source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS (free at developer.usajobs.gov) — US public sector, clean salary bands
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Supabase — the scraper mirror AND the /employers job-submission capture.
# Schema in supabase/migrations/ (run 0001 + 0002). On Vercel set these in the
# project's Environment Variables; locally the web falls back to a mailto.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Postmark (optional) — emails you when an employer submits a job. Without it
# the submission still lands in Supabase; you just check the table.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
POSTMARK_NOTIFY_TO=

# Admin console (/admin) — HTTP Basic Auth for reviewing job submissions.
ADMIN_PASSWORD=
ADMIN_USER=

# Lemon Squeezy (automated employer payments, Merchant of Record). Create a
# store + two product variants (Standard, Featured), an API key, and a webhook
# (event order_created) at https://www.pivothop.com/api/lemonsqueezy/webhook.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STD=
LEMONSQUEEZY_VARIANT_FEAT=
LEMONSQUEEZY_WEBHOOK_SECRET=
